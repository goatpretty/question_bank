# ============================================
# 必填
# ============================================
DATABASE_URL="file:./var/question-bank.db"
JWT_SECRET="replace-with-openssl-rand-base64-48"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"
PORT=3001

# 前端地址；生产环境反向代理/跨域时填写，同源部署可留空
FRONTEND_URL="http://localhost:5173"

# 运行期上传目录（头像等），默认 var/uploads；该目录不进入 Git
UPLOAD_DIR="var/uploads"

# ============================================
# 可选：邮件验证
# 未配置时无法发送验证码，自助注册与邮箱重置密码不可用；请由管理员创建账号
# ============================================
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================
# 可选：AI 助手
# 默认关闭；开启后用户提问会发送到所配置的外部服务
# ============================================
AI_ENABLED=false
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_DAILY_QUOTA=50

# ============================================
# 首次初始化
# ============================================
SEED_DEMO=false
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
